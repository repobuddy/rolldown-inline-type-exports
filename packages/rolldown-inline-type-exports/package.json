{
	"name": "@repobuddy/rolldown-inline-type-exports",
	"version": "1.0.0",
	"description": "Rolldown plugin that inlines trailing type exports in DTS files to fix TS2742",
	"keywords": [
		"repobuddy",
		"rolldown",
		"tsdown",
		"typescript",
		"dts",
		"plugin"
	],
	"homepage": "https://github.com/repobuddy/rolldown-inline-type-exports",
	"bugs": {
		"url": "https://github.com/repobuddy/rolldown-inline-type-exports/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/rolldown-inline-type-exports.git",
		"directory": "packages/rolldown-inline-type-exports"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src",
		"!**/*.{spec,test,unit}.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf coverage dist --glob *.tsbuildinfo",
		"lint": "pnpm run -w check",
		"nuke": "rimraf node_modules",
		"test": "vitest run",
		"verify": "npm-run-all clean -p build lint test"
	},
	"peerDependencies": {
		"rolldown": ">=1.0.0"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.1.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.1.3",
		"rolldown": "^1.0.2",
		"tsdown": "^0.22.0",
		"typescript": "^6.0.0",
		"vitest": "^4.0.18"
	},
	"publishConfig": {
		"access": "public"
	}
}
